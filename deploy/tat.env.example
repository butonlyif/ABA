# TAT 自动化助手 凭据(本地开发用,不进 git)
# 复制为 tat.env 并填值,deploy.sh 会自动走 TAT 通道(免 22 端口)
# 控制台路径: https://console.cloud.tencent.com/tat  → API密钥管理
TAT_SECRET_ID=your-secret-id-here
TAT_SECRET_KEY=your-secret-key-here
TAT_REGION=ap-shanghai
TAT_INSTANCE_ID=your-instance-id-here
TAT_COMMAND_ID_API=your-api-command-id-here
TAT_COMMAND_ID_WEB=your-web-command-id-here